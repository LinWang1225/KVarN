+        num_attention_heads=32,
+        num_key_value_heads=8,
+        hidden_size=4096,
+        head_dim=128,
+    )
+    expected = 2 * 36 * 32768 * 8 * 128 * 2
+    assert estimate_shadow_cache_bytes(config, 32768) == expected
